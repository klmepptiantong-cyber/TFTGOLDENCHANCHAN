{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TFTGOLDENCHANCHAN Overlay",
  "version": "0.8.1",
  "identifier": "com.tftgoldenchanchan.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TFTGOLDENCHANCHAN Overlay",
        "width": 430,
        "height": 760,
        "minWidth": 350,
        "minHeight": 250,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://game.gtimg.cn; connect-src 'self' https://raw.githubusercontent.com; object-src 'none'; frame-src 'none'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false
  }
}